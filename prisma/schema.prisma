model User {
  id                   String            @id @db.Uuid
  email                String?           @unique @db.Text
  passwordHash         String?
  name                 String?
  avatarUrl            String?
  role                 String            @default("USER")
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  deletedAt            DateTime?

  lastAdAt             DateTime?
  twoFactorSecret      String?
  isTwoFactorEnabled   Boolean           @default(false)
  maxSessions          Int               @default(1)
  isPremium            Boolean           @default(false)
  plan                 String            @default("FREE")
  stripeCustomerId     String?           @unique
  stripeSubscriptionId String?           @unique
  subscriptionStatus   String?
  referralCode         String?           @unique
  referredById         String?           @db.Uuid
  lastFingerprint      String?
  lastIp               String?
  riskScore            Float?            @default(0)
  isBanned             Boolean           @default(false)
  resellerId           String?
  metadata             Json?
  
  // Relations
  referredBy           User?             @relation("UserReferral", fields: [referredById], references: [id])
  referrals            User[]            @relation("UserReferral")
  reseller             Reseller?         @relation(fields: [resellerId], references: [id])
  
  favorites            FavoriteChannel[]
  sessions             Session[]
  securityEvents       SecurityEvent[]
  watchHistory         WatchHistory[]
  playlists            Playlist[]
  securityProfile      UserSecurityProfile?
  tenantUsers          TenantUser[]

  @@index([resellerId])
  @@schema("public")
}

model Tenant {
  id        String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  createdAt DateTime     @default(now())
  webhookUrl String?
  
  
  users     TenantUser[]
  channels  Channel[]

  @@schema("public")
}

model TenantPlan {
  id        String @id @default(uuid())
  tenantId  String @unique

  plan      String  @default("free") // free | pro | enterprise

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
  @@schema("public")
}

model TenantUsage {
  id        String @id @default(uuid())
  tenantId  String
  date      DateTime @db.Date

  apiCalls        Int @default(0)
  sseConnections  Int @default(0)
  metricsRequests  Int @default(0)
  streamEvents     Int @default(0)

  @@unique([tenantId, date])
  @@schema("public")
}

model TenantQuota {
  id        String @id @default(uuid())
  tenantId  String @unique

  maxApiCallsPerDay      Int @default(100)
  maxSseConnections      Int @default(10)
  maxMetricsRequests     Int @default(50)

  updatedAt DateTime @updatedAt
  @@schema("public")
}

model Alert {
  id          String   @id @default(uuid())
  tenantId    String
  type        String   // ERROR_RATE | LATENCY | QUOTA | SYSTEM
  severity    String   // INFO | WARNING | CRITICAL

  title       String
  message     String
  metric      String?
  value       Float?
  threshold   Float?

  status      String   @default("OPEN") // OPEN | ACK | RESOLVED

  metadata    Json?

  createdAt   DateTime @default(now())
  resolvedAt  DateTime?
  
  @@schema("public")
}

model AuditLog {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String?  @db.Uuid
  userId    String?  @db.Uuid
  action    String
  ip        String?
  resource  String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([userId])
  @@index([action])
  @@schema("public")
}

model TenantUser {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String   @db.Uuid
  tenantId    String   @db.Uuid

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId])
  @@schema("public")
}

model Program {
  id          String   @id @default(cuid())
  channelId   String
  title       String
  description String?
  startTime   DateTime
  endTime     DateTime
  isLive      Boolean  @default(false)
  channel     Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@index([channelId, startTime, endTime])
  @@schema("public")
}

model FavoriteChannel {
  id        String   @id @default(cuid())
  userId    String   @db.Uuid
  channelId String
  createdAt DateTime @default(now())
  channel   Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, channelId])
  @@schema("public")
}

model WatchHistory {
  id           String   @id @default(cuid())
  userId       String   @db.Uuid
  channelId    String?
  movieId      String?
  episodeId    String?
  watchedAt    DateTime @default(now())
  durationSec  Int      @default(0)
  lastPosition Int      @default(0)
  
  channel      Channel? @relation(fields: [channelId], references: [id], onDelete: Cascade)
  movie        Movie?   @relation(fields: [movieId], references: [id], onDelete: Cascade)
  episode      Episode? @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, watchedAt])
  @@schema("public")
}

model UserSecurityProfile {
  id              String   @id @default(cuid())
  userId          String   @unique @db.Uuid
  isQuarantined   Boolean  @default(false)
  updatedAt       DateTime @updatedAt

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@schema("public")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String?  @unique
  userId       String   @db.Uuid
  ip           String?
  userAgent    String?
  revoked      Boolean  @default(false)
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@schema("public")
}

model Channel {
  id            String            @id
  name          String
  category      String
  logo          String?

  tenantId      String?           @db.Uuid
  tenant        Tenant?           @relation(fields: [tenantId], references: [id])
  viewers       String?
  streamSources Json?             
  thumbnail     String?
  streamUrl     String?           
  score         String?
  homeLogo      String?
  awayLogo      String?
  homeName      String?
  awayName      String?
  league        String?
  matchTime     String?
  scheduledAt   DateTime?
  status        String?           @default("UPCOMING")
  isPremium     Boolean           @default(false)
  isActive      Boolean           @default(true)
  deletedAt     DateTime?
  lastSeenAt    DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  playlistId    String?           
  
  playlist      Playlist?         @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  favorites     FavoriteChannel[]
  programs      Program[]
  history       WatchHistory[]
  featuredBy    FeaturedMatch[]
  matchStreams  MatchStream[]
  liveSources   LiveSource[]

  @@index([playlistId])
  @@schema("public")
}

model Movie {
  id           String         @id @default(cuid())
  playlistId   String
  title        String
  poster       String?
  backdrop     String?
  plot         String?
  rating       Float?
  director     String?
  stars        String?
  genre        String?
  year         Int?
  streamUrl    String
  createdAt    DateTime       @default(now())
  playlist     Playlist       @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  watchHistory WatchHistory[]

  @@index([playlistId])
  @@schema("public")
}

model Series {
  id           String    @id @default(cuid())
  playlistId   String
  title        String
  poster       String?
  backdrop     String?
  plot         String?
  rating       Float?
  genre        String?
  year         Int?
  createdAt    DateTime  @default(now())
  playlist     Playlist  @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  episodes     Episode[]

  @@index([playlistId])
  @@schema("public")
}

model Episode {
  id           String    @id @default(cuid())
  seriesId     String
  season       Int
  episode      Int
  title        String?
  streamUrl    String
  createdAt    DateTime  @default(now())
  series       Series    @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  watchHistory WatchHistory[]

  @@index([seriesId])
  @@schema("public")
}

model Playlist {
  id           String    @id @default(cuid())
  userId       String?   @db.Uuid
  name         String
  type         String    @default("M3U") 
  url          String?   
  host         String?   
  username     String?   
  passwordEnc  String?   
  status       String    @default("PENDING") 
  lastFetched  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  channels     Channel[]
  movies       Movie[]
  series       Series[]
  user         User?     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@schema("public")
}

model Ad {
  id          String   @id @default(cuid())
  name        String?
  vastUrl     String
  provider    String   @default("google") 

  weight      Float    @default(0.1)
  ctr         Float    @default(0)
  fillRate    Float    @default(0)
  baseCpm     Float    @default(0.1) 

  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@schema("public")
}

model AdEvent {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String   @db.Uuid
  userId         String   @db.Uuid
  provider       String
  eventType      String   @default("impression")
  revenue        Float
  qoeScore       Float?
  segment        String?  
  idempotencyKey String?  @unique
  createdAt      DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([userId])
  @@schema("public")
}

model AdToken {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tokenHash       String   @unique
  userId          String   @db.Uuid
  tenantId        String   @db.Uuid
  provider        String
  status          String   
  ecpmSnapshot    Float
  createdAt       DateTime @default(now())
  expiresAt       DateTime

  @@index([tokenHash])
  @@index([status])
  @@index([tenantId, createdAt])
  @@schema("public")
}

model SystemLock {
  key        String   @id
  ownerId    String
  lockedAt   DateTime @default(now())
  expiresAt  DateTime

  @@schema("public")
}

model AdDecisionLog {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String   @db.Uuid
  tenantId        String   @db.Uuid
  finalProvider   String
  candidates      Json     
  rejectedReasons Json     
  ecpmTrace       Json     
  trustScore      Float
  createdAt       DateTime @default(now())

  @@index([tenantId, createdAt])
  @@schema("public")
}

model StreamEvent {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String   @db.Uuid
  channelId  String
  eventType  String

  // NEW METRICS FIELDS
  latency    Float?      
  status     String?     
  tenantId   String?     @db.Uuid
  
  watchTime  Int?
  createdAt  DateTime @default(now())

  @@index([channelId])
  @@index([status])
  @@index([createdAt])
  @@schema("public")
}

model Reseller {
  id           String         @id @default(cuid())
  name         String
  email        String         @unique
  password     String
  credits      Int            @default(0)
  createdAt    DateTime       @default(now())
  resellerUsers ResellerUser[]
  users        User[]

  @@schema("public")
}

model ResellerUser {
  id         String   @id @default(cuid())
  resellerId String
  userId     String
  expiresAt  DateTime
  reseller   Reseller @relation(fields: [resellerId], references: [id])

  @@schema("public")
}

model AdProvider {
  id        String   @id @default(cuid())
  name      String   @unique
  baseUrl   String
  active    Boolean  @default(true)
  priority  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@schema("public")
}

model AppConfig {
  key   String @id
  value String

  @@schema("public")
}

model AdRevenue {
  id        String   @id @default(uuid())
  provider  String
  cpm       Float
  country   String?
  device    String?
  createdAt DateTime @default(now())

  @@schema("public")
}

model MetricsSnapshot {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  activeStreams  Int
  errorRate      Float
  avgLatency     Float
  createdAt      DateTime @default(now())

  @@index([createdAt])
  @@schema("public")
}

model SecurityEvent {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type      String   
  ip        String
  country   String?
  userId    String   @db.Uuid
  details   String?
  severity  String   @default("low") 
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@schema("public")
}

model Admin {
  id            String   @id @default(cuid())
  email         String   @unique
  password      String
  role          String   @default("admin")
  twoFASecret   String?
  twoFAEnabled  Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@schema("public")
}

model CreditLog {
  id         String   @id @default(cuid())
  resellerId String
  amount     Int
  reason     String
  createdAt  DateTime @default(now())

  @@index([resellerId])
  @@schema("public")
}

model ObservabilityEvent {
  id          String   @id @default(cuid())
  type        String
  fingerprint String?
  createdAt   DateTime @default(now())

  @@index([type])
  @@schema("public")
}

model StreamSessionLive {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String   @db.Uuid
  channelId   String   
  startedAt   DateTime @default(now())
  ended_at    DateTime? 

  device      String?
  quality     String?
  fingerprint String?
  tenantId    String?   @db.Uuid

  @@index([channelId])
  @@index([ended_at])
  @@schema("public")
}

model AIAnomalyScore {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String   @db.Uuid
  score           Float    
  continuityScore Float    @default(0.0)
  adjustmentFactor Float   @default(0.0)
  reasons         Json
  actionTaken     String   
  createdAt       DateTime @default(now())

  @@index([userId])
  @@index([score])
  @@schema("public")
}

model SystemHealthSnapshot {
  id             String   @id @default(uuid())
  activeSessions Int
  abuseRate      Float
  avgLatencyMs   Int
  errorRate      Float
  regionHotspots Json
  region         String   @default("fra") 
  status         String   
  createdAt      DateTime @default(now())

  @@index([status])
  @@index([createdAt])
  @@schema("public")
}

model HouseAd {
  id             String   @id @default(cuid())
  name           String?
  creativeUrl    String
  priority       Int      @default(0)
  minPressure    Float    @default(0.85)
  maxPressure    Float    @default(1.0)
  placementRules Json?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@schema("public")
}

model FeaturedMatch {
  id        String   @id @default(cuid())
  channelId String   @unique
  position  Int      @default(0)
  expiresAt DateTime?

  channel   Channel  @relation(fields: [channelId], references: [id])

  createdAt DateTime @default(now())

  @@index([position])
  @@schema("public")
}

model MatchStream {
  id        String   @id @default(cuid())
  channelId String
  type      String   
  url       String
  isActive  Boolean  @default(true)
  channel   Channel  @relation(fields: [channelId], references: [id])
  createdAt DateTime @default(now())

  @@index([channelId])
  @@schema("public")
}

model LiveSource {
  id          String   @id @default(cuid())
  channelId   String
  type        LiveSourceType
  url         String
  priority    Int      @default(0)
  isActive    Boolean  @default(true)
  apiKey      String?
  apiSecret   String?
  headers     Json?
  lastCheckedAt DateTime?
  healthScore    Float   @default(1.0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  channel     Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@index([channelId])
  @@index([type])
  @@schema("public")
}

enum LiveSourceType {
  API
  M3U
  IFRAME
  STREAM
  FACEBOOK
  YOUTUBE
  MP4
  RTMP

  @@schema("public")
}
