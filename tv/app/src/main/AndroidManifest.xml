<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Essential Android TV Leanback declaration -->
    <uses-feature
        android:name="android.software.leanback"
        android:required="true" />
        
    <!-- TV does not require a touchscreen -->
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <!-- Internet permissions for streaming -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.StreamPerfTV.NoActionBar"
        android:usesCleartextTraffic="true"> <!-- Allow HTTP dev server -->

        <!-- Main TV Activity -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:logo="@drawable/ic_launcher"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.StreamPerfTV.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <!-- Key filter making it visible in Android TV launchers -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
