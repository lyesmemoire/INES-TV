    "@vercel/analytics": "^2.0.1",
    "@wistia/wistia-player-react": "^0.6.19",
    "axios": "^1.15.2",
    "bcryptjs": "^3.0.3",
    "chart.js": "^4.5.1",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "cookie-parser": "^1.4.7",
    "date-fns": "^3.0.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "framer-motion": "^12.38.0",
    "geist": "^1.7.0",
    "helmet": "^8.1.0",
    "hls.js": "^1.5.0",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.309.0",
    "motion": "^12.38.0",
    "next": "14.1.0",
    "node-cron": "^4.2.1",
    "nodemailer": "^8.0.6",
    "p-limit": "^7.3.0",
    "pg": "^8.20.0",
    "qrcode": "^1.5.4",
    "react": "^18.2.0",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^18.2.0",
    "react-hot-toast": "^2.4.1",
    "react-is": "^19.2.5",
    "react-player": "^2.16.0",
    "recharts": "^3.8.1",
    "redis": "^4.6.12",
    "slugify": "^1.6.9",
    "socket.io": "^4.8.3",
    "speakeasy": "^2.0.0",
    "tailwind-merge": "^2.2.0",
